# syntax=docker/dockerfile:1.9

# Stage 1: Build frontend assets with Node LTS
FROM node:22-alpine AS node-builder

WORKDIR /build

# Copy package files first for better layer caching
COPY package.json package-lock.json ./

# Install dependencies (clean install for reproducible builds)
RUN npm ci --no-audit --no-fund

# Copy source and build assets
COPY . .
RUN npm run build

# Stage 2: PHP runtime with FrankenPHP
FROM dunglas/frankenphp:1.12.0-php8.5 AS frankenphp

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcap2-bin \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libzip-dev \
    libxml2-dev \
    libonig-dev \
    libpq-dev \
    libsqlite3-dev \
    unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        gd \
        pdo \
        pdo_pgsql \
        pdo_sqlite \
        mbstring \
        xml \
        bcmath \
        zip \
        fileinfo \
        openssl \
        ctype \
        json \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Install PHP dependencies (production only, optimized autoloader)
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress --no-scripts

# Copy application code
COPY . .

# Regenerate autoloader with full application code (classmap-authoritative for production)
RUN composer dump-autoload --no-dev --classmap-authoritative

# Copy built assets from Stage 1
COPY --from=node-builder /build/public/build ./public/build

# Create storage subdirectories and set permissions
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/framework/testing \
    storage/app \
    storage/app/public \
    && chown -R www-data:www-data storage bootstrap/cache

# Copy Caddyfile for FrankenPHP configuration
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# Allow non-root user to bind to privileged ports (< 1024)
# and ensure Caddy directories are writable by www-data
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Run container as non-root user
USER www-data

# Expose HTTP port
EXPOSE 80

# Healthcheck using Laravel's built-in /up route
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-80}/up || exit 1

# Run FrankenPHP in production mode
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
